# Demo mode (default): leave these empty to run the in-memory + file lab store.
# The app is fully usable without Supabase or an LLM key.

# --- Supabase (optional) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel AI SDK / OpenAI (optional ribosome) ---
# When set, translateMrnaToProtein calls generateText instead of the local ribosome.
OPENAI_API_KEY=
OPENAI_RIBOSOME_MODEL=gpt-4o-mini

# Override demo store location (Vercel uses /tmp automatically)
# DEMO_STORE_PATH=.data/lab.json
