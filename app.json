{
  "expo": {
    "name": "Drift",
    "slug": "drift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drift",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Drift needs your location to reveal notes within fifteen meters and to drop notes where you stand.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Drift listens quietly so nearby notes can wake you with a heartbeat."
      },
      "bundleIdentifier": "app.drift.notes"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1020",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ],
      "package": "app.drift.notes",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Drift to sense notes near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#05070D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
